PANEL_APP_NAME=Pelican
PANEL_APP_ENV=production
PANEL_APP_DEBUG=false
PANEL_APP_URL=http://localhost
PANEL_APP_TIMEZONE=UTC
PANEL_APP_LOCALE=en

PANEL_DATABASE_DRIVER=mysql
PANEL_DATABASE_HOST=127.0.0.1
PANEL_DATABASE_PORT=3306
PANEL_DATABASE_DATABASE=pelican
PANEL_DATABASE_USERNAME=pelican
PANEL_DATABASE_PASSWORD=
PANEL_DATABASE_CHARSET=utf8mb4
PANEL_DATABASE_COLLATION=utf8mb4_unicode_ci

PANEL_REDIS_HOST=127.0.0.1
PANEL_REDIS_PORT=6379
PANEL_REDIS_PASSWORD=
PANEL_REDIS_DB=0

PANEL_AUTH_2FA_REQUIRED=false
PANEL_AUTH_2FA_BYTES=32
PANEL_AUTH_2FA_WINDOW=4
PANEL_AUTH_VERIFY_NEWER=true

PANEL_API_KEY_LIMIT=25
PANEL_API_KEY_EXPIRE_TIME=720

PANEL_PANEL_USE_BINARY_PREFIX=true
PANEL_PANEL_EDITABLE_SERVER_DESCRIPTIONS=true
PANEL_PANEL_WEBHOOK_PRUNE_DAYS=30
PANEL_PANEL_FILES_MAX_EDIT_SIZE=4194304
